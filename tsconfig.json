{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-l3-final75-m-repair/types/**/*.ts",
    ".next-l3-final75-m-repair/dev/types/**/*.ts",
    ".next-restoration-20260808/types/**/*.ts",
    ".next-restoration-20260808/dev/types/**/*.ts",
    ".next-restoration-20260808-final7/types/**/*.ts",
    ".next-restoration-20260808-final7/dev/types/**/*.ts",
    ".next-d7-20260808-final1/types/**/*.ts",
    ".next-d7-20260808-final1/dev/types/**/*.ts",
    ".next-d7-20260808-final2/types/**/*.ts",
    ".next-d7-20260808-final2/dev/types/**/*.ts",
    ".next-d7-20260808-final3/types/**/*.ts",
    ".next-d7-20260808-final3/dev/types/**/*.ts",
    ".next-d7-20260808-final4/types/**/*.ts",
    ".next-d7-20260808-final4/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
